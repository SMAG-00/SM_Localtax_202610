# 환경변수 이름 목록 (ENV-02·05). 값은 비워 둔다 — 실제 값은 .env.local(커밋 금지)·Vercel 환경변수·GitHub Actions Secrets에만 넣는다.
# 줄 끝 주석의 [범위]는 scripts/env-scopes.json과 같아야 한다 (scripts/check-env.mjs가 검사).
# 로컬·Preview·Development = Supabase staging·Anthropic 개발 키, Production = Supabase prod·Anthropic 운영 키.

# ── 1단계 ──────────────────────────────────────
NEXT_PUBLIC_SITE_URL=            # [공개] 서비스 주소 — 로컬 http://localhost:3001, 전환 전에는 테스트 주소
NEXT_PUBLIC_SUPABASE_URL=        # [공개] https://<ref>.supabase.co (로컬은 http://127.0.0.1:55321)
NEXT_PUBLIC_SUPABASE_ANON_KEY=   # [공개] RLS로 보호되는 공개 키
SITE_INDEXING=                   # [서버] 권고값 off — 운영 도메인 전환 전에는 모든 페이지 noindex·robots 차단, 전환 당일 on
ADMIN_EMAILS=                    # [서버] 관리자 이메일 (쉼표 구분)
MAIL_FROM=                       # [서버] 발신자 이름과 주소
SENTRY_DSN=                      # [서버] 선택 — 오류 추적
ANTHROPIC_MODEL_ANSWER=          # [서버] AI 도우미 답변 모델 — 권고값 claude-sonnet-5-5 (PRD_최종 §6.2)
ANTHROPIC_MODEL_ROUTER=          # [서버] AI 도우미 의도 분류 모델 — 권고값 claude-haiku-5-5
ASSISTANT_ENABLED=               # [서버] 기능 플래그 — 비우면 꺼짐. 100문항 평가 통과 전에는 off
ASSISTANT_DAILY_TOKEN_BUDGET=    # [서버] 일일 토큰 예산 — 넘으면 '검색 결과만' 모드
ASSISTANT_RATE_LIMIT=            # [서버] 속도 제한
ASSISTANT_RETENTION_DAYS=        # [서버] 마스킹본 보관 기간 — 권고값 30
SUPABASE_SERVICE_ROLE_KEY=       # [서버 전용] 비밀 — AI 도우미(packages/assistant)는 쓰지 않는다
ANTHROPIC_API_KEY=               # [서버 전용] 비밀 — 사용자 경로 키 하나 (1단계 AI 도우미 · 4단계 지방세봇 모드)
RESEND_API_KEY=                  # [서버 전용] 비밀 — 메일 발송
CRON_SECRET=                     # [서버 전용] 비밀 — /api/jobs/* 호출 인증 (Vercel Cron · 사내 스케줄러)
# PORT는 두지 않는다 — 개발 서버는 3001 고정(개발 스크립트), Docker는 컨테이너 설정에서 정한다

# ── CI 전용 (GitHub Actions Secrets — .env.local·Vercel에 넣지 않는다) ──
SUPABASE_DB_URL=                 # [CI 전용] 비밀 — 마이그레이션 적용·RLS 검증 (로컬 Supabase는 비워 두면 자동)
SUPABASE_ACCESS_TOKEN=           # [CI 전용] 비밀 — Supabase CLI
VERCEL_TOKEN=                    # [CI 전용] 비밀 — 배포·환경변수 점검
FORBIDDEN_IDENTIFIERS=           # [CI 전용] 비밀 — SM 플랫폼 식별자 금지 목록 (FND-05, 쉼표 구분)
